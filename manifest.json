{
  "manifest_version": 3,
  "name": "代理控制台",
  "version": "0.1.0",
  "description": "一屏切换代理情景，状态与出口始终可见。",
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "privacy"
  ],
  "host_permissions": [
    "https://api.ipify.org/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "代理控制台",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "src/options/index.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "打开代理控制台"
    }
  }
}
